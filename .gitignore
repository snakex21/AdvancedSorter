.gradle
**/build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
.classpath
.settings/
bin/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# VS Code
.vscode/

# System
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Minecraft dev runs (runClient/runServer), worlds, logs and crash reports
run/
logs/
crash-reports/
saves/
*.log

# Local data, caches and secrets
*.db
*.sqlite
*.sqlite3
.env
.env.*
__pycache__/
*.pyc
